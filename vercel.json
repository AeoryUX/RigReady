{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@10.34.9 install --frozen-lockfile",
  "buildCommand": "PORT=5173 BASE_PATH=/ npx --yes pnpm@10.34.9 --filter @workspace/rigready-ai run build",
  "outputDirectory": "artifacts/rigready-ai/dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
