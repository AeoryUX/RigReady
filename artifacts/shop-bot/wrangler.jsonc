{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "rigready-shop-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGIN": "https://aeoryux.github.io" },
  "ratelimits": [{
    "name": "SEARCH_RATE_LIMITER",
    "namespace_id": "77301",
    "simple": { "limit": 6, "period": 60 }
  }]
}
